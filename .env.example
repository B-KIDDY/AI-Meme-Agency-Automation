# Copy this file to .env and fill in your keys

# OpenAI (optional - system falls back to local humor engine if missing)
OPENAI_API_KEY=sk-your-key-here

# ========== INSTAGRAM LIVE POSTING ==========
# Set RUN_MODE=live to enable real posts
RUN_MODE=sim

# Instagram Graph API (required for live)
INSTAGRAM_ACCESS_TOKEN=your_long_lived_page_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_ig_business_account_id

# Public image hosting (REQUIRED for live – Instagram needs a public HTTPS URL)
# Option A – free Imgur (easiest for testing)
IMGUR_CLIENT_ID=your_imgur_client_id

# Option B – your own server / CDN
# PUBLIC_IMAGE_BASE_URL=https://yourdomain.com/memes

# How many memes to generate per daily run
MEMES_TO_GENERATE=30
MEMES_TO_KEEP=10

# Humor styles (comma separated)
HUMOR_STYLES=relatable,dark,gaming,programming,anime,sarcastic
